# Maintainer-only local release signing. Copy to gitignored keystore.properties
# and fill from this app's existing release key. Agents never generate keys.
# CI instead uses RATAMATAP_KEYSTORE_FILE / RATAMATAP_KEYSTORE_PASSWORD /
# RATAMATAP_KEY_ALIAS / RATAMATAP_KEY_PASSWORD. Never commit real values or the key.
storeFile=/absolute/path/to/ratamatap-release.keystore
storePassword=REPLACE_ME
keyAlias=ratamatap
keyPassword=REPLACE_ME
