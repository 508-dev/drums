<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: the M1 timing diagnostics screen, with its own launcher entry. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
        M5 (#28): the diagnostics screen's microphone tools. Asked for at runtime only
        when "Listen" is pressed. Release builds gain it with scoring itself (#30).
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <application>
        <!--
            Handles rotation itself, so a long timing run isn't restarted by turning the phone.
            Shows over the lock screen, so adb-driven runs (and their mic capture, which needs a
            foreground activity) work on a locked test phone.
        -->
        <activity
            android:name=".diagnostics.TimingDiagnosticsActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:exported="true"
            android:label="@string/timing_diagnostics_label"
            android:showWhenLocked="true"
            android:turnScreenOn="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
